rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public waitlist signups are WRITE-ONLY from the browser client.
    // No read/update/delete via the SDK, so emails and responses stay private.
    // Dedup is handled by using sha256(email) as the document ID (see
    // WaitlistModal.tsx): a repeat signup targets an existing doc, which the
    // create-only rule denies — no read access required.
    match /waitlist/{id} {
      allow read, update, delete: if false;
      allow create: if isValidSignup(request.resource.data);
    }

    // Everything else (incl. the legacy contact-submissions collection) is locked.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidSignup(d) {
      return d.keys().hasOnly([
               'email', 'country', 'user_personas', 'user_personas_other',
               'use_cases', 'use_cases_other', 'consent', 'source', 'createdAt'
             ])
          && d.email is string && d.email.size() <= 200 && d.email.matches('.*@.*\\..*')
          && d.country is string && d.country.size() == 2
          && d.user_personas is list && d.user_personas.size() >= 1 && d.user_personas.size() <= 12
          && d.use_cases is list && d.use_cases.size() >= 1 && d.use_cases.size() <= 12
          && (d.user_personas_other == null || (d.user_personas_other is string && d.user_personas_other.size() <= 80))
          && (d.use_cases_other == null || (d.use_cases_other is string && d.use_cases_other.size() <= 120))
          && d.consent == true
          && d.source is string && d.source.size() <= 40
          && d.createdAt is string && d.createdAt.size() <= 40;
    }
  }
}
