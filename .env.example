# Database (Neon Postgres) — waitlist signups. Auto-provisioned by the
# Vercel Marketplace Neon integration; pull locally with `vercel env pull`.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Google Analytics
NEXT_PUBLIC_GA_ID=

# GitHub Changelog (releases source)
GITHUB_CHANGELOG_OWNER=your-github-org
GITHUB_CHANGELOG_REPO=your-repo-name
GITHUB_TOKEN=ghp_optional_for_private_repos

# Resend Email Configuration
RESEND_API_KEY=re_your_api_key_here
CONTACT_EMAIL=your-email@example.com
